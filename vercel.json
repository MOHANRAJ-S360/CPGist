{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/signin",
      "destination": "https://cpgistai.vercel.app/?mode=signup",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://cpgistai.vercel.app/?mode=signup",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://cpgistai.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
